<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Capture console exception logs on IIS as well as startup failures. -->
      <aspNetCore processPath="dotnet" arguments=".\MIS.API.dll" hostingModel="inprocess"
                  stdoutLogEnabled="true" stdoutLogFile=".\App_Data\logs\stdout" />
    </system.webServer>
  </location>
</configuration>
